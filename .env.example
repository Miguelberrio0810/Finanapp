# Supabase Postgres — Project Settings > Database > Connection string
# Usa el "Transaction pooler" (puerto 6543) para queries normales, funciona en serverless
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Usa el "Session pooler" o la conexión directa (puerto 5432) solo para migraciones
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Opcional: consejo del Diagnóstico IA con Claude. Sin clave se usa el cálculo local.
# Solo se lee en el servidor (/api/diagnostico); nunca uses el prefijo NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
